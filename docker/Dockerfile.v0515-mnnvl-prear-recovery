ARG BASE_IMAGE=gitlab.aws.omniva.com:5050/acls/security-analytics/sglang@sha256:bf521f069d1f4720f1fb3a89eb16d20682aa109f045855c26913bc6294768965
FROM flashinfer_source AS flashinfer_source
FROM ${BASE_IMAGE}

ARG SGLANG_BUILD_COMMIT=unknown
ARG FLASHINFER_BUILD_COMMIT=unknown

COPY python/sglang/srt/environ.py /sgl-workspace/sglang/python/sglang/srt/environ.py
COPY python/sglang/srt/layers/flashinfer_comm_fusion.py /sgl-workspace/sglang/python/sglang/srt/layers/flashinfer_comm_fusion.py
COPY python/sglang/srt/models/deepseek_v2.py /sgl-workspace/sglang/python/sglang/srt/models/deepseek_v2.py
COPY test/registered/unit/layers/test_flashinfer_comm_fusion.py /sgl-workspace/sglang/test/registered/unit/layers/test_flashinfer_comm_fusion.py

COPY --from=flashinfer_source /csrc/trtllm_mnnvl_allreduce.cu /opt/flashinfer-gb200-phase65-prear-add/csrc/trtllm_mnnvl_allreduce.cu
COPY --from=flashinfer_source /include/flashinfer/comm/trtllm_mnnvl_allreduce.cuh /opt/flashinfer-gb200-phase65-prear-add/include/flashinfer/comm/trtllm_mnnvl_allreduce.cuh
