COPY --from=flashinfer_source /flashinfer/comm/workspace_base.py /opt/flashinfer-gb200-phase65-prear-add/flashinfer/comm/workspace_base.py

LABEL org.opencontainers.image.revision="${SGLANG_BUILD_COMMIT}" \
      omniva.flashinfer.revision="${FLASHINFER_BUILD_COMMIT}" \
      omniva.experiment="v0.5.15-mnnvl-preallreduce-recovery-20260716" \
      omniva.flashinfer.preallreduce.backend="trtllm,mnnvl"
