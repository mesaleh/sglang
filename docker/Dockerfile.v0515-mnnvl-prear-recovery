ARG BASE_IMAGE=gitlab.aws.omniva.com:5050/acls/security-analytics/sglang@sha256:bf521f069d1f4720f1fb3a89eb16d20682aa109f045855c26913bc6294768965
FROM flashinfer_source AS flashinfer_source
FROM ${BASE_IMAGE}

ARG PROMOTION_SGLANG_BUILD_COMMIT=unknown
ARG PROMOTION_FLASHINFER_BUILD_COMMIT=unknown
ARG PROMOTION_FLASHINFER_SOURCE_TREE_SHA256=unknown
ARG PROMOTION_FLASHINFER_PATCH_SHA256=unknown
ARG PROMOTION_SGLANG_BUILD_URL=unknown
ARG PROMOTION_SGLANG_IMAGE_TAG=unknown

ENV SGLANG_BUILD_COMMIT=${PROMOTION_SGLANG_BUILD_COMMIT} \
    FLASHINFER_BUILD_COMMIT=${PROMOTION_FLASHINFER_BUILD_COMMIT} \
    SGLANG_BUILD_URL=${PROMOTION_SGLANG_BUILD_URL} \
    SGLANG_IMAGE_TAG=${PROMOTION_SGLANG_IMAGE_TAG}

COPY python/sglang/srt/environ.py /sgl-workspace/sglang/python/sglang/srt/environ.py
COPY python/sglang/srt/layers/communicator.py /sgl-workspace/sglang/python/sglang/srt/layers/communicator.py
COPY python/sglang/srt/layers/flashinfer_comm_fusion.py /sgl-workspace/sglang/python/sglang/srt/layers/flashinfer_comm_fusion.py
COPY python/sglang/srt/models/deepseek_v2.py /sgl-workspace/sglang/python/sglang/srt/models/deepseek_v2.py
COPY test/registered/unit/layers/test_flashinfer_comm_fusion.py /sgl-workspace/sglang/test/registered/unit/layers/test_flashinfer_comm_fusion.py

COPY docker/autotune/gb200-kimi-k26-tp8/ /root/.cache/sglang/
COPY docker/flashinfer-patches/v0.6.8.post1-omniva-mnnvl-pre-allreduce-add.patch.gz /opt/flashinfer-gb200-phase65-prear-add/source/v0.6.8.post1-omniva-mnnvl-pre-allreduce-add.patch.gz

COPY --from=flashinfer_source /csrc/trtllm_mnnvl_allreduce.cu /opt/flashinfer-gb200-phase65-prear-add/csrc/trtllm_mnnvl_allreduce.cu
COPY --from=flashinfer_source /include/flashinfer/comm/trtllm_mnnvl_allreduce.cuh /opt/flashinfer-gb200-phase65-prear-add/include/flashinfer/comm/trtllm_mnnvl_allreduce.cuh
COPY --from=flashinfer_source /flashinfer/comm/__init__.py /opt/flashinfer-gb200-phase65-prear-add/flashinfer/comm/__init__.py
COPY --from=flashinfer_source /flashinfer/comm/allreduce.py /opt/flashinfer-gb200-phase65-prear-add/flashinfer/comm/allreduce.py
COPY --from=flashinfer_source /flashinfer/comm/trtllm_mnnvl_ar.py /opt/flashinfer-gb200-phase65-prear-add/flashinfer/comm/trtllm_mnnvl_ar.py
COPY --from=flashinfer_source /flashinfer/comm/workspace_base.py /opt/flashinfer-gb200-phase65-prear-add/flashinfer/comm/workspace_base.py

LABEL ai.sglang.build.commit="${PROMOTION_SGLANG_BUILD_COMMIT}" \
      ai.sglang.build.url="${PROMOTION_SGLANG_BUILD_URL}" \
      ai.sglang.image.tag="${PROMOTION_SGLANG_IMAGE_TAG}" \
      org.opencontainers.image.revision="${PROMOTION_SGLANG_BUILD_COMMIT}" \
      org.opencontainers.image.version="${PROMOTION_SGLANG_IMAGE_TAG}" \
      omniva.flashinfer.revision="${PROMOTION_FLASHINFER_BUILD_COMMIT}" \
      omniva.flashinfer.source_tree_sha256="${PROMOTION_FLASHINFER_SOURCE_TREE_SHA256}" \
      omniva.flashinfer.source_patch_sha256="${PROMOTION_FLASHINFER_PATCH_SHA256}" \
      omniva.flashinfer.autotune.config="gb200-kimi-k26-tp8-control-confirm-20260716" \
      omniva.experiment="v0.5.15-mnnvl-preallreduce-recovery-20260716" \
      omniva.flashinfer.preallreduce.backend="trtllm,mnnvl"
